// DAX query generated by Fabric Copilot with "What is the turnover for August 2021 for Key Account Account Types only for Miller Space?"
EVALUATE
  CALCULATETABLE(
    // Return a single-row table with the Turnover value for the specified filters
    ROW("Turnover", [Turnover]),
    'Date'[Calendar Year Number (ie 2021)] = 2021,            // Filter for year 2021
    'Date'[Calendar Month (ie Jan)] = "Aug",                   // Filter for the month August
    Customers[Account Type] = "Key Account",                  // Filter for Key Account account types
    Customers[Key Account Name] = "Miller Space"              // Filter for the key account "Miller Space"
  )
ORDER BY
  [Turnover] ASC