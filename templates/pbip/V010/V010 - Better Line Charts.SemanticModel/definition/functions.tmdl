/// Helper function to dynamically round and format values
function 'DaxLib.FormatString.Component.DynamicUnits' =
		
		// Helper function to dynamically round and format values
		(
		    // Base format string
		    base_format: STRING,
		    // Expects a valid format string base, i.e. "#,##0"
		
		    // The value to format
		    // EXPR because it must be able to handle SELECTEDMEASURE() and arbitrary expressions
		    format_value: EXPR
		)
		=>
		    VAR _CurrentValue =
		        format_value
		
		    VAR _Format =
		        base_format &
		        SWITCH (
		            TRUE (),
		            _CurrentValue <= 1E3, ".0",
		            _CurrentValue <= 1E6, ",.0K",
		            _CurrentValue <= 1E9, ",,.0M",
		            _CurrentValue <= 1E12, ",,,.0B",
		            _CurrentValue <= 1E15, ",,,,.0T"
		        )
		    RETURN
		        _Format
	lineageTag: e8daf533-8db3-4163-95ba-cf0012fea0fb

