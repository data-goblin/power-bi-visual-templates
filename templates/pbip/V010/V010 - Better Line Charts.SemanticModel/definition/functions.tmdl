/// Convert duration in seconds to HH:MM:SS format string
function 'DaxLib.FormatString.HHMMSS.Seconds' =
		
		// Convert duration in seconds to HH:MM:SS format string
		// To be used on a measure that returns a value in seconds
		() =>
		    VAR _TotalSeconds = SELECTEDMEASURE ()
		
		    VAR _Hours =
		        INT( _TotalSeconds / 3600 )
		
		    VAR _Minutes =
		        INT( MOD( _TotalSeconds, 3600 ) / 60 )
		
		    VAR _Seconds =
		        INT( MOD( _TotalSeconds, 60 ) )
		
		    VAR _Result =
		        DaxLib.FormatString.Component.MakeStringSafe(
		            FORMAT ( _Hours, "00" ) & ":" &
		            FORMAT ( _Minutes, "00" ) & ":" &
		            FORMAT ( _Seconds, "00" )
		        )
		
		    RETURN
		        _Result
	lineageTag: 875ccee3-3683-43e9-a81c-b51b5be7ace1

	extendedProperty TabularEditor_ObjDaxPkgContentHash = ECA4428D782EAEE7D4D31643DC07CED98D94DECFD6D895E482151819D61C4A50

	extendedProperty TabularEditor_ObjDaxPkgHandle = 1

/// Convert duration between start and end times to HH:MM:SS format string
function 'DaxLib.FormatString.HHMMSS.StartTimeEndTime' =
		
		// Convert duration between start and end times to HH:MM:SS format string
		(
		    // Start datetime
		    // Include measure, expression, or scalar value
		    startTime: EXPR,
		
		    // End datetime
		    // Include measure, expression, or scalar value
		    endTime: EXPR
		) =>
		    VAR _DurationInSeconds =
		        INT( ( endTime - startTime ) * 86400 )
		
		    VAR _Hours =
		        INT( _DurationInSeconds / 3600 )
		
		    VAR _Minutes =
		        INT( MOD( _DurationInSeconds, 3600 ) / 60 )
		
		    VAR _Seconds =
		        INT( MOD( _DurationInSeconds, 60 ) )
		
		    VAR _Result =
		        DaxLib.FormatString.Component.MakeStringSafe(
		            FORMAT ( _Hours, "00" ) & ":" &
		            FORMAT ( _Minutes, "00" ) & ":" &
		            FORMAT ( _Seconds, "00" )
		        )
		
		    RETURN
		        _Result
	lineageTag: 455ac181-a213-4841-a0c7-e0d769f8b47d

	extendedProperty TabularEditor_ObjDaxPkgContentHash = 7568F5DCEADDA11AEBD96D2DC916839518A53699AFD7B42F69ACFD03338B57E8

