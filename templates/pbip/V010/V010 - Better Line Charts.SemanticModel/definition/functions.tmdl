/// Returns a centered moving average of the expression, calculated symmetrically around the current period (e.g., 3 periods back + current + 3 periods forward = 7-period centered MA).
function 'TimeSeries.MovingAverage.Centered' = ```
		( 
		    dateColumn : ANYREF EXPR, 
		    timeSeriesTable: ANYREF EXPR,
		    periodsBack : SCALAR INT64, 
		    periodsForward : SCALAR INT64, 
		    expression : NUMERIC EXPR ) =>
		VAR _Window = 
		    CALCULATETABLE( 
		        WINDOW( -periodsBack, REL, periodsForward, REL, SUMMARIZE ( ALL ( timeSeriesTable ), dateColumn ), ORDERBY( dateColumn, ASC ) ), 
		        LASTNONBLANK( dateColumn, expression )
		    )
		RETURN
		    AVERAGEX( _Window, expression )
		```
