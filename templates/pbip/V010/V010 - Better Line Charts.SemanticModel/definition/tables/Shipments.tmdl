	partition Shipments = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(#"DataFolder" & "\Shipments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
				        {"Billing Document Number", type text}, {"Billing Document Line Item Number", Int64.Type},
				        {"Billing Date", type date}, {"Customer Key", Int64.Type}, {"Product Key", Int64.Type},
				        {"Ship Date", type date}, {"OTD Indicator", type text}, {"Billing Document Type Code", type text},
				        {"Local Currency", type text}, {"Delivery Cost", type number}, {"Net Invoice COGS", type number},
				        {"Late Delivery Penalties", type number}, {"Overdue Payment Penalties", type number},
				        {"Taxes & Commercial Fees", type number}, {"Freight", type number},
				        {"Net Invoice Value", type number}, {"Net Invoice Quantity", Int64.Type}
				    }),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each [Billing Date] >= Date.From(#"RangeStart") and [Billing Date] < Date.From(#"RangeEnd"))
				in
				    #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

