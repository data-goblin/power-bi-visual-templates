table Shipments
	lineageTag: e864ea7c-38b6-44bc-92b6-e167034b7f19

	/// Count of invoice line items.
	measure '# Invoice Lines' = COUNTROWS ( Shipments )
		formatString: #,##0
		displayFolder: Measures
		lineageTag: 0fab4eac-d56c-45a6-a5c8-8c3ceb38ba83

	/// Gross Profit in EUR (Revenue minus COGS), converted via Budget Rate.
	measure 'Gross Profit' =
			SUMX (
			    Shipments,
			    ( Shipments[Net Invoice Value] - Shipments[Net Invoice COGS] )
			        / RELATED ( 'Budget Rate'[Rate] )
			)
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000001

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Gross Margin as a percentage of Revenue.
	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000002

	/// Total Revenue in EUR (Net Invoice Value converted via Budget Rate).
	measure Revenue =
			SUMX (
			    Shipments,
			    Shipments[Net Invoice Value]
			        / RELATED ( 'Budget Rate'[Rate] )
			)
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000003

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Total Cost of Goods Sold in EUR.
	measure COGS =
			SUMX (
			    Shipments,
			    Shipments[Net Invoice COGS]
			        / RELATED ( 'Budget Rate'[Rate] )
			)
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000004

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Gross Profit from the same period one year prior, used for year-over-year comparisons.
	measure 'Gross Profit (PY)' =
			CALCULATE (
			    [Gross Profit],
			    DATEADD ( 'Date'[Date], -1, YEAR ),
			    REMOVEFILTERS ( 'Date'[IsThisYear], 'Date'[IsDateInScope] )
			)
		displayFolder: Measures
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80299

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Year-over-year change in Gross Profit expressed as a percentage.
	measure 'Gross Profit YoY %' = DIVIDE ( [Gross Profit] - [Gross Profit (PY)], [Gross Profit (PY)] )
		formatString: ↑#,##0.0%;↓#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80301

	/// Gross Margin % from the same period one year prior, used for year-over-year comparisons.
	measure 'Gross Margin % (PY)' =
			CALCULATE (
			    [Gross Margin %],
			    DATEADD ( 'Date'[Date], -1, YEAR ),
			    REMOVEFILTERS ( 'Date'[IsThisYear], 'Date'[IsDateInScope] )
			)
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80302

	/// Total shipped units (Net Invoice Quantity).
	measure '# Units Sold' = SUM ( Shipments[Net Invoice Quantity] )
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000010

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "",
				        ""
				    )
				RETURN _FormatString

	/// Year-over-year change in Gross Margin % expressed in percentage points.
	measure 'Gross Margin % YoY' = [Gross Margin %] - [Gross Margin % (PY)]
		formatString: ↑#,##0.0%;↓#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: b7ceff5b-356a-4f7d-9f7a-e05c1a2b6410

	/// Year-over-year change in Revenue (current period minus prior year).
	measure 'Revenue YoY' = [Revenue] - [Revenue (PY)]
		displayFolder: Measures
		lineageTag: d16fdaaf-311b-46ce-9620-9bf01010cb51

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN
				    "↑" & _FormatString & ";↓" & _FormatString & ";" & _FormatString

	/// Revenue from the same period one year prior, used for year-over-year comparisons.
	measure 'Revenue (PY)' =
			CALCULATE (
			    [Revenue],
			    DATEADD ( 'Date'[Date], -1, YEAR ),
			    REMOVEFILTERS ( 'Date'[IsThisYear], 'Date'[IsDateInScope] )
			)
		displayFolder: Measures
		lineageTag: 8d0781f5-10cb-4a02-82b5-feebfc41c046

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Year-over-year change in COGS (current period minus prior year).
	measure 'COGS YoY' = [COGS] - [COGS (PY)]
		displayFolder: Measures
		lineageTag: e8d175ac-745e-4af0-b577-63086623c683

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN
				    "↑" & _FormatString & ";↓" & _FormatString & ";" & _FormatString

	/// COGS from the same period one year prior, used for year-over-year comparisons.
	measure 'COGS (PY)' =
			CALCULATE (
			    [COGS],
			    DATEADD ( 'Date'[Date], -1, YEAR ),
			    REMOVEFILTERS ( 'Date'[IsThisYear], 'Date'[IsDateInScope] )
			)
		displayFolder: Measures
		lineageTag: e15946c8-2c6e-47f2-ba9d-dfaac2e64d8b

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Year-over-year change in Gross Profit (current period minus prior year).
	measure 'Gross Profit YoY' = [Gross Profit] - [Gross Profit (PY)]
		displayFolder: Measures
		lineageTag: ababca69-61d2-4ceb-8239-3e70411266c5

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN
				    "↑" & _FormatString & ";↓" & _FormatString & ";" & _FormatString

	measure 'Revenue Cumulative %' =
			VAR _CurrentRevenue = [Revenue]
			VAR _CumulativeRevenue =
			    SUMX(
			        FILTER(
			            ALLSELECTED( 'Customer'[Customer Sold-To Name] ),
			            [Revenue] >= _CurrentRevenue
			        ),
			        [Revenue]
			    )
			VAR _TotalRevenue =
			    CALCULATE(
			        [Revenue],
			        ALLSELECTED( 'Customer'[Customer Sold-To Name] )
			    )
			RETURN
			    DIVIDE( _CumulativeRevenue, _TotalRevenue )
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		displayFolder: Measures\Report Objects
		lineageTag: e5a82f22-edaa-4a7b-b70d-8e97f4b8a76e

	measure 'Pareto 80%' = 0.8
		formatString: 0%
		displayFolder: Measures
		lineageTag: 74508e82-0ffa-47ba-a226-40dd18460a51

	measure 'CF - Pareto Column Color' = IF ( [Revenue Cumulative %] <= 0.8, "#0AADAD", "#85D6D6" )
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: 98e01409-399d-4be5-b911-0c0df7a0d010

	/// Year-over-year change in Revenue expressed as a percentage.
	measure 'Revenue YoY %' = DIVIDE( [Revenue YoY], [Revenue (PY)] )
		formatString: ↑#,##0.0%;↓#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: dfd55801-a17b-42bf-959a-7308d777ff8c

	/// Year-over-year change in COGS expressed as a percentage.
	measure 'COGS YoY %' = DIVIDE ( [COGS] - [COGS (PY)], [COGS (PY)] )
		formatString: ↑#,##0.0%;↓#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: ee66dfef-47bd-40c8-9b0c-6be915c9afd4

