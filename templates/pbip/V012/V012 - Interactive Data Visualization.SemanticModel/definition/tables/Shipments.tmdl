	measure 'CF - Page Title Exploration' =
			VAR _Station = IF ( ISFILTERED ( Region[Station] ), SELECTEDVALUE ( Region[Station] ) )
			VAR _Brand = IF ( ISFILTERED ( Brand[Brand] ), SELECTEDVALUE ( Brand[Brand] ) )
			VAR _Customer = IF ( ISFILTERED ( Customer[Customer Sold-To Name] ), SELECTEDVALUE ( Customer[Customer Sold-To Name] ) )
			VAR _Month =
			    IF (
			        ISFILTERED ( 'Date'[Date] ) || ISFILTERED ( 'Date'[Calendar Month Year (ie Jan 21)] ),
			        SELECTEDVALUE ( 'Date'[Calendar Month Year (ie Jan 21)] )
			    )
			VAR _Subtype = IF ( ISFILTERED ( Product[Subtype] ), SELECTEDVALUE ( Product[Subtype] ) )
			VAR _Product = IF ( ISFILTERED ( Product[Product Name] ), SELECTEDVALUE ( Product[Product Name] ) )
			VAR _Material = IF ( ISFILTERED ( Product[Material] ), SELECTEDVALUE ( Product[Material] ) )
			VAR _Context =
			    COALESCE ( _Customer, _Station, _Brand, _Product, _Subtype, _Material, _Month )
			RETURN
			    IF ( ISBLANK ( _Context ), "Exploration", "Exploring: " & _Context )
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: cf5a0001-0001-0001-0001-000000000003

	measure 'CF - Selected Customer Sold-To Name' = SELECTEDVALUE( Customer[Customer Sold-To Name] )
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: ff429321-92bc-40bd-b986-697515653d88

	measure 'CF - Bar Chart X Min' =
			VAR _Nudge = 0.5
			VAR _Min =
			    MINX (
			        ALLSELECTED ( 'Region'[Station] ),
			        [Gross Margin % vs PY pp]
			    )
			RETURN
			    _Min * ( 1 + _Nudge )
		formatString: 0.0
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: a14a0001-0001-0001-0001-000000000101

	measure 'CF - Bar Chart X Max' =
			VAR _Nudge = 0.4
			VAR _Max =
			    MAXX (
			        ALLSELECTED ( 'Region'[Station] ),
			        [Gross Margin % vs PY pp]
			    )
			RETURN
			    _Max * ( 1 + _Nudge )
		formatString: 0.0
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: a14a0001-0001-0001-0001-000000000102

