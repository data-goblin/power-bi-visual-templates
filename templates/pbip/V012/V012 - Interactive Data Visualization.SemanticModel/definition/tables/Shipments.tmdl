table Shipments
	lineageTag: e864ea7c-38b6-44bc-92b6-e167034b7f19

	/// Count of invoice line items.
	measure '# Invoice Lines' = COUNTROWS ( Shipments )
		formatString: #,##0
		displayFolder: Measures
		lineageTag: 0fab4eac-d56c-45a6-a5c8-8c3ceb38ba83

	/// Gross Profit in EUR (Revenue minus COGS), converted via Budget Rate.
	measure 'Gross Profit' =
			SUMX (
			    Shipments,
			    ( Shipments[Net Invoice Value] - Shipments[Net Invoice COGS] )
			        / RELATED ( 'Budget Rate'[Rate] )
			)
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000001

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Gross Margin as a percentage of Revenue.
	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000002

	/// Total Revenue in EUR (Net Invoice Value converted via Budget Rate).
	measure Revenue =
			SUMX (
			    Shipments,
			    Shipments[Net Invoice Value]
			        / RELATED ( 'Budget Rate'[Rate] )
			)
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000003

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Total Cost of Goods Sold in EUR.
	measure COGS =
			SUMX (
			    Shipments,
			    Shipments[Net Invoice COGS]
			        / RELATED ( 'Budget Rate'[Rate] )
			)
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000004

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Gross Profit from the same period one year prior, used for year-over-year comparisons.
	measure 'Gross Profit (PY)' =
			CALCULATE (
			    [Gross Profit],
			    DATEADD ( 'Date'[Date], -1, YEAR ),
			    REMOVEFILTERS ( 'Date'[IsThisYear], 'Date'[IsDateInScope] )
			)
		displayFolder: Measures
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80299

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "€",
				        ""
				    )
				RETURN _FormatString

	/// Year-over-year change in Gross Profit expressed as a percentage.
	measure 'Gross Profit vs PY %' = DIVIDE ( [Gross Profit] - [Gross Profit (PY)], [Gross Profit (PY)] )
		formatString: ↑#,##0.0%;↓#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80301

	/// Gross Margin % from the same period one year prior, used for year-over-year comparisons.
	measure 'Gross Margin % (PY)' =
			CALCULATE (
			    [Gross Margin %],
			    DATEADD ( 'Date'[Date], -1, YEAR ),
			    REMOVEFILTERS ( 'Date'[IsThisYear], 'Date'[IsDateInScope] )
			)
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		displayFolder: Measures
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80302

	/// Year-over-year change in Gross Margin % expressed in percentage points. Excludes incomplete current month.
	measure 'Gross Margin % vs PY pp' =
			VAR _RefIsEndOfMonth = [RefDate] = EOMONTH ( [RefDate], 0 )
			VAR _LastCompleteMonthEnd =
			    IF ( _RefIsEndOfMonth, EOMONTH ( [RefDate], 0 ), EOMONTH ( [RefDate], -1 ) )
			VAR _GM =
			    CALCULATE ( [Gross Margin %], 'Date'[Date] <= _LastCompleteMonthEnd )
			VAR _GMPY =
			    CALCULATE ( [Gross Margin % (PY)], 'Date'[Date] <= _LastCompleteMonthEnd )
			RETURN
			    100 * ( _GM - _GMPY )
		formatString: ↑0.#\p\p;↓0.#\p\p
		displayFolder: Measures
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80303

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'CF - KPI Title Gross Margin %' =
			VAR _Value = [Gross Margin %]
			VAR _MonthLabel =
			    IF (
			        HASONEVALUE ( 'Date'[Calendar Month Year (ie Jan 21)] ),
			        " in " & VALUES ( 'Date'[Calendar Month Year (ie Jan 21)] ),
			        ""
			    )
			RETURN
			    FORMAT ( _Value, "#,##0.0%" ) & " Gross Margin" & _MonthLabel
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80304

	measure 'CF - Last Complete Month and PY Month Gross Margin %' =
			VAR _RefIsEndOfMonth =
			    [RefDate] = EOMONTH( [RefDate], 0 )
			VAR _LastCompleteMonthEnd =
			    IF(
			        _RefIsEndOfMonth,
			        EOMONTH( [RefDate], 0 ),
			        EOMONTH( [RefDate], -1 )
			    )
			VAR _PYMonthEnd =
			    EOMONTH( _LastCompleteMonthEnd, -12 )
			VAR _CurrentMonthEnd =
			    EOMONTH( MAX( 'Date'[Date] ), 0 )
			RETURN
			    IF(
			        _CurrentMonthEnd = _LastCompleteMonthEnd
			            || _CurrentMonthEnd = _PYMonthEnd,
			        [Gross Margin %]
			    )
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: a11f3ebe-1528-4ad9-8c83-03085b8c68e8

	measure 'CF - Current Incomplete and Last Complete Month Gross Margin %' =
			VAR _RefIsEndOfMonth = [RefDate] = EOMONTH ( [RefDate], 0 )
			  VAR _LastCompleteMonthEnd =
			      IF ( _RefIsEndOfMonth, EOMONTH ( [RefDate], 0 ), EOMONTH ( [RefDate],
			  -1 ) )
			  VAR _RefMonthEnd = EOMONTH ( [RefDate], 0 )
			  VAR _EndOfMonth = EOMONTH ( MAX ( 'Date'[Date] ), 0 )
			  RETURN
			      IF (
			          NOT _RefIsEndOfMonth
			              && ( _EndOfMonth = _RefMonthEnd || _EndOfMonth =
			  _LastCompleteMonthEnd ),
			          [Gross Margin %]
			      )
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: 3a969d6e-3913-46a8-b72e-021d7b44b056

	measure 'CF - Last Complete Month and 12 Preceding Months Gross Margin %' =
			VAR _RefIsEndOfMonth = [RefDate] = EOMONTH ( [RefDate], 0 )
			  VAR _LastCompleteMonthEnd =
			      IF ( _RefIsEndOfMonth, EOMONTH ( [RefDate], 0 ), EOMONTH ( [RefDate],
			  -1 ) )
			  VAR _WindowStart = EOMONTH ( [RefDate], -14 )
			  VAR _EndOfMonth = EOMONTH ( MAX ( 'Date'[Date] ), 0 )
			  RETURN
			      IF (
			          _EndOfMonth <= _LastCompleteMonthEnd && _EndOfMonth >
			  _WindowStart,
			          [Gross Margin %]
			      )
		formatString: #,##0.0%;-#,##0.0%;#,##0.0%
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: 8f6ed42f-8b8a-492d-bb63-1b1bd654a2c3

	/// Total shipped units (Net Invoice Quantity).
	measure '# Units Sold' = SUM ( Shipments[Net Invoice Quantity] )
		displayFolder: Measures
		lineageTag: f1000001-0001-0001-0001-000000000010

		formatStringDefinition =
				VAR _Value = SELECTEDMEASURE()
				VAR _FormatString =
				    DaxLib.FormatString.DynamicUnits (
				        _Value,
				        "",
				        "",
				        "",
				        ""
				    )
				RETURN _FormatString

	measure 'CF - KPI Title Gross Profit' =
			VAR _Value = [Gross Profit]
			VAR _FormatString =
			    DaxLib.FormatString.DynamicUnits (
			        _Value,
			        "",
			        "",
			        "€",
			        ""
			    )
			RETURN
			    FORMAT ( _Value, _FormatString ) & " Gross Profit"
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80320

	measure 'CF - KPI Subtitle Gross Profit vs PY' =
			VAR _RefIsEndOfMonth = [RefDate] = EOMONTH ( [RefDate], 0 )
			VAR _LastCompleteMonthEnd =
			    IF ( _RefIsEndOfMonth, EOMONTH ( [RefDate], 0 ), EOMONTH ( [RefDate], -1 ) )
			VAR _Change =
			    CALCULATE ( [Gross Profit vs PY %], 'Date'[Date] <= _LastCompleteMonthEnd )
			VAR _MinDate = MIN ( Shipments[Billing Date] )
			VAR _MaxDate = _LastCompleteMonthEnd
			VAR _PYMin = EDATE ( _MinDate, -12 )
			VAR _PYMax = EDATE ( _MaxDate, -12 )
			VAR _PYMinMonth = FORMAT ( _PYMin, "MMM" )
			VAR _PYMaxMonth = FORMAT ( _PYMax, "MMM" )
			VAR _PYMinYear = FORMAT ( _PYMin, "'YY" )
			VAR _PYMaxYear = FORMAT ( _PYMax, "'YY" )
			VAR _PYMinLabel = _PYMinMonth & " " & _PYMinYear
			VAR _PYMaxLabel = _PYMaxMonth & " " & _PYMaxYear
			VAR _Suffix =
			    IF (
			        _PYMinLabel = _PYMaxLabel,
			        " vs " & _PYMinLabel,
			        IF (
			            _PYMinYear = _PYMaxYear,
			            " vs PY (" & _PYMinMonth & " – " & _PYMaxLabel & ")",
			            " vs PY (" & _PYMinLabel & " – " & _PYMaxLabel & ")"
			        )
			    )
			VAR _FormatString =
			    DaxLib.FormatString.RelativeToTarget.Percents (
			        "PREFIX",
			        1,
			        "ARROWS",
			        "",
			        _Suffix
			    )
			RETURN
			    FORMAT ( _Change, _FormatString )
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80321

	measure 'CF - Time Range Label' =
			VAR _MinDate = MIN ( 'Date'[Date] )
			VAR _MaxDate = MIN ( MAX ( 'Date'[Date] ), [RefDate] )
			VAR _SameMonth =
			    YEAR ( _MinDate ) = YEAR ( _MaxDate )
			        && MONTH ( _MinDate ) = MONTH ( _MaxDate )
			VAR _MinLabel = FORMAT ( _MinDate, "MMM D, 'YY" )
			VAR _MaxLabel = FORMAT ( _MaxDate, "MMM D, 'YY" )
			RETURN
			    IF (
			        ISBLANK ( _MinDate ),
			        "",
			        IF (
			            _SameMonth,
			            FORMAT ( _MinDate, "MMM 'YY" ),
			            _MinLabel & " – " & _MaxLabel
			        )
			    )
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80323

	measure 'CF - Last Complete Month Gross Margin % vs PY pp' =
			VAR _RefIsEndOfMonth =
			    [RefDate] = EOMONTH ( [RefDate], 0 )
			VAR _LastCompleteMonthEnd =
			    IF (
			        _RefIsEndOfMonth,
			        EOMONTH ( [RefDate], 0 ),
			        EOMONTH ( [RefDate], -1 )
			    )
			VAR _CurrentMonthEnd =
			    EOMONTH ( MAX ( 'Date'[Date] ), 0 )
			VAR _Change = [Gross Margin % vs PY pp]
			VAR _FormatString =
			    DaxLib.FormatString.RelativeToTarget.Numeric (
			        "PREFIX",
			        1,
			        "TRIANGLES",
			        "",
			        "pp"
			    )
			RETURN
			    IF (
			        _CurrentMonthEnd = _LastCompleteMonthEnd,
			        FORMAT ( _Change, _FormatString )
			    )
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: fc9b595f-fea8-423f-afff-abece8b80322

	measure 'CF - Scatter Chart X Min' =
			VAR _Order = SELECTEDVALUE ( 'ScatterChartXMetricSelector'[ScatterChartXAxis Order] )
			VAR _Table =
			    ADDCOLUMNS (
			        VALUES ( Customer[Customer Sold-To Name] ),
			        "@v",
			            SWITCH (
			                _Order,
			                0, CALCULATE ( [COGS] ),
			                1, CALCULATE ( [Gross Margin %] ),
			                2, CALCULATE ( [Gross Profit] ),
			                3, CALCULATE ( [# Invoice Lines] ),
			                4, CALCULATE ( [Revenue] ),
			                5, CALCULATE ( [# Units Sold] )
			            )
			    )
			VAR _Min = MINX ( _Table, [@v] )
			VAR _Max = MAXX ( _Table, [@v] )
			VAR _Range = _Max - _Min
			RETURN
			    _Min - _Range * 0.1
		isHidden
		displayFolder: Measures\Report Objects
		lineageTag: f1000001-0001-0001-0001-000000000018

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CF - Scatter Chart X Max' =
			VAR _Order = SELECTEDVALUE ( 'ScatterChartXMetricSelector'[ScatterChartXAxis Order] )
			VAR _Table =
