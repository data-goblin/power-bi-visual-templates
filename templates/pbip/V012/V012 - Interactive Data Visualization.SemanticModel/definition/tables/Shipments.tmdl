			        && MONTH ( _PYMin ) = MONTH ( _PYMax )
			VAR _MinLabel = FORMAT ( _PYMin, "MMM 'YY" )
			VAR _MaxLabel = FORMAT ( _PYMax, "MMM 'YY" )
			VAR _DateRange =
