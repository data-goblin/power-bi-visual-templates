model DeepReach
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Tables

	annotation PBI_QueryGroupOrder = 1

extendedProperty TabularEditor_ModelDaxPkgSeq = 3

extendedProperty TabularEditor_ModelDaxPkgTable =
		{
		  "1": {
		    "Provider": "https://api.daxlib.org",
		    "PackageId": "DaxLib.FormatString",
		    "Version": "0.1.2"
		  },
		  "2": {
		    "Provider": "https://api.daxlib.org",
		    "PackageId": "TimeSeries.MovingAverage",
		    "Version": "0.1.1"
		  }
		}

annotation TabularEditor_SerializeOptions = {"IgnoreInferredObjects":true,"IgnoreInferredProperties":true,"IgnoreTimestamps":true,"SplitMultilineStrings":true,"PrefixFilenames":false,"LocalTranslations":true,"LocalPerspectives":true,"LocalRelationships":true,"Levels":["Data Sources","Shared Expressions","Perspectives","Relationships","Roles","Tables","Tables/Columns","Tables/Hierarchies","Tables/Measures","Tables/Partitions","Tables/CalculationItems","Translations"]}

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Brand","Budget Rate","Customer","Exchange Rate","Invoice Document Type","Product","Region","Shipments","Supplier","Procurement","DataFolder","RangeStart","RangeEnd"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop","MCP-PBIModeling"]

ref table Brand
ref table 'Budget Rate'
ref table Customer
ref table 'Exchange Rate'
ref table 'Invoice Document Type'
ref table Product
ref table Region
ref table Shipments
ref table Date
ref table Supplier
ref table Procurement

ref cultureInfo en-US

