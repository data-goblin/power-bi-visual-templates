			RETURN
			    _Min - _Nudge
		displayFolder: Measures\Scatterplot
		lineageTag: 967dcd8d-b2b8-4491-9b98-33e8eab20142

	/// Upper Y bound for the customer-grain CY-vs-PY scatter.
	/// Mirror of Scatter Customer Revenue PY Min.
	measure 'Scatter Customer Revenue PY Max' =
			VAR _Pad = 0.08
			VAR _Points =
			    FILTER (
